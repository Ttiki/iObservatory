<?xml version="1.0" encoding="UTF-8"?>
<impactModel xmlns="urn:impact-pathway:0.1" xmlns:exec="urn:iobservatory:execution:0.1"
             id="demo-model" version="0.1">
  <initiative id="demo" name="Monitoring compilation demonstration" type="programme">
    <activities><activity id="workshop" name="Workshop">
      <indicator id="participant-count" name="Participants"><unit>people</unit></indicator>
    </activity></activities>
  </initiative>
  <!-- Optional experimental execution extension, not part of the pathway language. -->
  <exec:bindings>
    <exec:sqlBinding indicatorRef="participant-count" connection="observatory_dw">
      SELECT 'demo-edition-1'::text AS record_key,
             TIMESTAMPTZ '2026-11-18 00:00:00+00' AS observed_at,
             12::numeric AS value
    </exec:sqlBinding>
  </exec:bindings>
</impactModel>
